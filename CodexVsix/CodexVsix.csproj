<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CodexVsix</AssemblyName>
    <TargetName>CodexVsix</TargetName>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\</OutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <CreatePkgDefAssemblyToProcess>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll</CreatePkgDefAssemblyToProcess>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <DeployExtension>false</DeployExtension>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <NoWarn>VSSDK006;VSSDK008</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAuditMode>all</NuGetAuditMode>
    <BuildVsixPackage Condition="'$(BuildVsixPackage)' == ''">false</BuildVsixPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DeployExtension>true</DeployExtension>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp /log</StartArguments>
    <StartWorkingDirectory>$(DevEnvDir)</StartWorkingDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <BuildVsixPackage>true</BuildVsixPackage>
  </PropertyGroup>

  <Target Name="BuildVsixArtifacts"
          AfterTargets="Build"
          Condition="'$(MSBuildRuntimeType)' != 'Core' and ('$(Configuration)' == 'Debug' or '$(BuildVsixPackage)' == 'true')">
    <CallTarget Targets="GeneratePkgDef;CopyVsixManifestFile;CreateVsixContainer" />
  </Target>

  <Target Name="IncludeMenusCtmenuInVsix"
          BeforeTargets="GetVsixSourceItems"
          DependsOnTargets="VSCTCompile">
    <ItemGroup>
      <VSIXSourceItem Include="$(IntermediateOutputPath)Commands.cto">
        <TargetPath>Menus.ctmenu</TargetPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <Target Name="IncludeNewtonsoftJsonInVsix"
          BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Include="$(OutputPath)Newtonsoft.Json.dll"
                      Condition="Exists('$(OutputPath)Newtonsoft.Json.dll')">
        <TargetPath>Newtonsoft.Json.dll</TargetPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <Target Name="ForceGeneratedVsixManifestVersion"
          AfterTargets="DetokenizeVsixManifestFile"
          Condition="Exists('$(IntermediateVsixManifest)')">
    <XmlPoke XmlInputPath="$(IntermediateVsixManifest)"
             Query="//*[local-name()='Identity']/@Version"
             Value="$(Version)" />
  </Target>

  <Target Name="IncludeReleaseNotesInVsix" BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Include="$(MSBuildProjectDirectory)\..\CHANGELOG.md">
        <TargetPath>ReleaseNotes.txt</TargetPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <Target Name="GenerateExtensionVersionSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ExtensionVersionSource>$(IntermediateOutputPath)ExtensionVersion.g.cs</_ExtensionVersionSource>
    </PropertyGroup>
    <ItemGroup>
      <_ExtensionVersionLine Include="using System.Reflection%3B" />
      <_ExtensionVersionLine Include="[assembly: AssemblyVersion(&quot;$(AssemblyVersion)&quot;)]" />
      <_ExtensionVersionLine Include="[assembly: AssemblyFileVersion(&quot;$(FileVersion)&quot;)]" />
      <_ExtensionVersionLine Include="namespace CodexVsix" />
      <_ExtensionVersionLine Include="{" />
      <_ExtensionVersionLine Include="    internal static class ExtensionInfo" />
      <_ExtensionVersionLine Include="    {" />
      <_ExtensionVersionLine Include="        public const string Version = &quot;$(Version)&quot;%3B" />
      <_ExtensionVersionLine Include="    }" />
      <_ExtensionVersionLine Include="}" />
      <Compile Include="$(_ExtensionVersionSource)" Visible="false" />
    </ItemGroup>
    <WriteLinesToFile File="$(_ExtensionVersionSource)"
                      Lines="@(_ExtensionVersionLine)"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>

  <Target Name="DeployVsixToExperimentalInstance"
          AfterTargets="BuildVsixArtifacts"
          Condition="'$(Configuration)' == 'Debug' and '$(MSBuildRuntimeType)' != 'Core' and '$(BuildingInsideVisualStudio)' == 'true'">
    <CallTarget Targets="DeployVsixExtensionFiles" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.551" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- Keep this aligned with the Newtonsoft.Json API surface hosted by supported Visual Studio versions. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="MessagePack" Version="3.1.9" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="Commands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <Content Include="Resources\MarketplaceIcon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\LICENSE" Link="LICENSE">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\CONTRIBUTORS.md" Link="CONTRIBUTORS.md">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <EmbeddedResource Include="UI\Assets\mermaid.min.js">
      <LogicalName>CodexVsix.UI.Assets.mermaid.min.js</LogicalName>
    </EmbeddedResource>
    <Content Include="UI\CodexWebview\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <Import Project="$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets"
          Condition="'$(PkgMicrosoft_VSSDK_BuildTools)' != '' and Exists('$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets')" />
</Project>
